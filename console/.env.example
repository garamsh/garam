# Base URL of the Go backend (`garam serve api`). The `/api/*` rewrite
# and the server-side API client both target it; browsers never see it.
# Optional in development, where it defaults to the value below;
# required in production — a build without it fails fast.
GARAM_API_URL=http://localhost:8080

# Where the site is served (ADR-0131): the way in, which a signed-out
# visitor is sent to. Optional in development, where it defaults to the
# value below.
GARAM_SITE_URL=http://garam.localhost:3001

# Where cowork's web app is served. The console's sidebar links each
# organization's cowork workspace below it, and offers no link where
# this is unset.
# COWORK_WEB_URL=http://localhost:3100
