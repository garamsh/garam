    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.1",
