# Copy to deploy/local/.env — docker compose loads it automatically.
# Real secrets never get committed.

# Postgres, as reached from inside the compose network. Change it only
# to point the stack at a database outside compose.
GARAM_DATABASE_URL=postgres://garam:garam@postgres:5432/garam?sslmode=disable

# Host ports. Defaults avoid the root dev compose, which holds 55432.
GARAM_LOCAL_DB_PORT=55433
GARAM_LOCAL_API_PORT=8080
GARAM_LOCAL_WEB_PORT=3000

# Google OAuth. Sign-in fails until these hold real credentials; the
# rest of the stack starts without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/callback/google

# Opt-in dev sign-in (ADR-0010): a "Dev sign-in" button on /login that
# creates a real session without Google. Localhost tooling — never
# enable it anywhere else.
GARAM_DEV_AUTH=false
# The dev provider's callback. It must stay on the web origin's /api
# rewrite; change it only together with GARAM_LOCAL_WEB_PORT.
GARAM_DEV_REDIRECT_URL=http://localhost:3000/api/auth/callback/dev
