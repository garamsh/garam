# Copy to deploy/local/.env — docker compose loads it automatically.
# Real secrets never get committed.

# Postgres, as reached from inside the compose network. The stack owns
# the `garam` database; `make integration` truncates, so the Go suites
# work on a separate `garam_test` on the same server. Change this only
# to point the stack at a database outside compose.
GARAM_DATABASE_URL=postgres://garam:garam@postgres:5432/garam?sslmode=disable

# Host ports. `make integration`, `make e2e` and `make web-e2e` ask
# compose which port it published rather than assuming one, so moving a
# port here moves it for them too.
GARAM_DB_PORT=25432
GARAM_LOCAL_API_PORT=8080
GARAM_LOCAL_WEB_PORT=3000
GARAM_LOCAL_SITE_PORT=3001
# The authz engine's Prometheus endpoint, and the port its /healthz and
# /readyz answer on. The engine speaks gRPC only, so GARAM_METRICS_ADDR
# gives both an HTTP listener of their own, fixed at `:9091` in the
# compose file like the other in-container addresses; this is the host
# port it is published on. The api serves /metrics and both probes on
# GARAM_LOCAL_API_PORT, and the web app serves both probes on
# GARAM_LOCAL_WEB_PORT.
GARAM_LOCAL_METRICS_PORT=9091

# Google OAuth. Sign-in fails until these hold real credentials; the
# rest of the stack starts without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://garam.localhost:3001/api/auth/callback/google
