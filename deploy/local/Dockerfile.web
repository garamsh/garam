# Multi-stage build of the Next.js frontend (ADR-0009) as a standalone
# server. Build context is `web/`.
#
# All three stages take the same base, pinned by digest: the tag reads
# and the digest resolves, so two builds of this commit pull the same
# bytes. Dependabot proposes a newer tag — `.github/dependabot.yml`
# names what it does not cover — and a move by hand re-resolves with
# `docker buildx imagetools inspect <ref>`.

FROM node:26.10.0-alpine3.24@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS deps

WORKDIR /app
RUN npm install -g pnpm@11.11.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:26.10.0-alpine3.24@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS build

WORKDIR /app
RUN npm install -g pnpm@11.11.0

# The `/api/*` rewrite is baked into the build, so the backend URL has
# to be known here as well as at runtime.
ARG GARAM_API_URL=http://api:8080
ENV GARAM_API_URL=$GARAM_API_URL

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build

FROM node:26.10.0-alpine3.24@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80

WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000

# `output: "standalone"` emits a self-contained server plus the subset
# of node_modules it needs, and nothing else: neither .next/static nor
# public/ is in it, so both are copied alongside. An asset missing from
# here 404s at runtime and nothing in the build says so.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

# The commit and the version the build was given, recorded on the image
# so a deployment resolves back to a source without going through the
# git tag, which moves. Both are strings the builder passes in and
# neither is derived from the layers, so each records what the build
# claimed rather than what the image is. Unset, both labels are present
# and empty, so a build that claimed nothing reads differently from an
# image built before they existed.
ARG IMAGE_REVISION
ARG IMAGE_VERSION
LABEL org.opencontainers.image.revision=$IMAGE_REVISION \
  org.opencontainers.image.version=$IMAGE_VERSION

USER node
EXPOSE 3000
CMD ["node", "server.js"]
