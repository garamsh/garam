# Multi-stage build of the Next.js frontend (ADR-0009) as a standalone
# server. Build context is `web/`.
#
# All three stages take the same base, pinned by digest: the tag reads
# and the digest resolves, so two builds of this commit pull the same
# bytes. Dependabot proposes a newer tag — `.github/dependabot.yml`
# names what it does not cover — and a move by hand re-resolves with
# `docker buildx imagetools inspect <ref>`.

FROM node:26.7.0-alpine3.24@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019 AS deps

WORKDIR /app
RUN npm install -g pnpm@11.11.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM node:26.7.0-alpine3.24@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019 AS build

WORKDIR /app
RUN npm install -g pnpm@11.11.0

# The `/api/*` rewrite is baked into the build, so the backend URL has
# to be known here as well as at runtime.
ARG GARAM_API_URL=http://api:8080
ENV GARAM_API_URL=$GARAM_API_URL

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm build

FROM node:26.7.0-alpine3.24@sha256:aadf416b2cdce311a8811ba3f0608a61b77dbf997500e2eafe781b51f6a0b019

WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000

# `output: "standalone"` emits a self-contained server plus the subset
# of node_modules it needs; static assets are copied alongside it.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static

USER node
EXPOSE 3000
CMD ["node", "server.js"]
