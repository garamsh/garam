{
  "name": "@garam/platform-sdk-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint",
    "format": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../platform/api/openapi.yaml -o src/api.ts"
  },
  "dependencies": {
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "next": "16.3.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "msw": "2.15.0",
    "next": "16.3.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.11.0"
}
