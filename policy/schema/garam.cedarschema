// The vocabulary a decision can name: entity types, actions and
// attributes (ADR-0130). An entity's identifier is its GRN.

// Every resource names its organization, which tenant isolation reads
// (ADR-0137). An organization names itself. A User names none: it may
// belong to several, each a parent, and no action is asked of a User.
//
// Parents are the fixed, shallow hierarchy: organization, then team and
// project, then channel. No team sits in a team.
entity Org { org: Org };
entity Team, Project in [Org] { org: Org };
entity Channel in [Org, Project] { org: Org };
entity Page, Task, Artifact in [Org] { org: Org };
entity Operator, Policy in [Org] { org: Org };
entity Agent in [Org, Team, Project] { org: Org };
entity User in [Org, Team, Project];

// A role is an action group, granted through a template in
// system-policies/. These three hold what Role.Actions grants in
// platform/internal/org/role.go, and a test holds the two together
// until roles leave the platform (ADR-0130).
action "role-owner", "role-admin", "role-member";

// Each `<service>:*` group is the wildcard Role.Actions names. Agent,
// operator and cowork actions are named one at a time and have none, so
// a later action is granted when it is decided.
action "org:*" in ["role-owner"];
action "group:*", "project:*", "policy:*", "consent:*"
  in ["role-owner", "role-admin"];

action "org:read", "org:member-list"
  in ["org:*", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org] };
action "org:update", "org:invite" in ["org:*", "role-admin"]
  appliesTo { principal: [User, Agent], resource: [Org] };
action "org:delete" in ["org:*"]
  appliesTo { principal: [User, Agent], resource: [Org] };

action "group:read", "group:member-list" in ["group:*", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Team] };
action "group:create", "group:update", "group:delete", "group:member-add",
  "group:member-remove" in ["group:*"]
  appliesTo { principal: [User, Agent], resource: [Org, Team] };

action "project:read", "project:member-list"
  in ["project:*", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Project] };
action "project:create", "project:update", "project:delete",
  "project:member-add", "project:member-remove" in ["project:*"]
  appliesTo { principal: [User, Agent], resource: [Org, Project] };

action "policy:create", "policy:read", "policy:update", "policy:attach",
  "policy:detach", "policy:delete" in ["policy:*"]
  appliesTo { principal: [User, Agent], resource: [Org, Policy] };

action "consent:read", "consent:grant", "consent:withdraw" in ["consent:*"]
  appliesTo { principal: [User, Agent], resource: [Org] };

action "operator:read" in ["role-owner", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Operator] };
action "operator:register", "operator:update", "operator:delete",
  "operator:reissue", "operator:delegate" in ["role-owner", "role-admin"]
  appliesTo { principal: [User, Agent], resource: [Org, Operator] };

action "agent:read", "agent:rename", "agent:create"
  in ["role-owner", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Agent] };
action "agent:configure", "agent:recover", "agent:enroll", "agent:replace",
  "agent:execution-read" in ["role-owner", "role-admin"]
  appliesTo { principal: [User, Agent], resource: [Org, Agent] };

// No role holds it: a grant carries it or nothing does (ADR-0022).
action "agent:watch"
  appliesTo { principal: [User, Agent], resource: [Org, Agent] };

action "agent-template:read", "execution-profile:read"
  in ["role-owner", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org] };
action "agent-template:publish" in ["role-owner", "role-admin"]
  appliesTo { principal: [User, Agent], resource: [Org] };

action "cowork:page-read", "cowork:page-write"
  in ["role-owner", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Page] };
action "cowork:channel-read", "cowork:channel-post"
  in ["role-owner", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Channel] };
action "cowork:task-read", "cowork:task-write"
  in ["role-owner", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Task] };
action "cowork:artifact-read", "cowork:artifact-write"
  in ["role-owner", "role-admin", "role-member"]
  appliesTo { principal: [User, Agent], resource: [Org, Artifact] };

action "message:send"
  appliesTo { principal: [Agent], resource: [Agent] };
