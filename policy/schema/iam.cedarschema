// The platform's manifest: the entity types, actions and attributes of
// the `iam` service, which a decision can name (ADR-0130, ADR-0143).
// An entity's identifier is its GRN.
//
// `@service` is the service's name, `@grn` the type segment an entity
// is written as in a GRN, and `@caller` the `sub` of the caller that
// writes it, or `none` (ADR-0143 item 1).
@service("iam")
namespace Iam {
  // Every resource names its organization, and an organization names
  // itself and its members, which is what tenant isolation reads
  // (ADR-0137). A User names no organization: it may be a member of
  // several, and no action is asked of a User.
  //
  // OrgMembers holds an organization's members and sits outside the
  // containment below, so `in` reaches it from a member and from
  // nothing else: a principal in a team of an organization is not in
  // it. No GRN names it, so it carries no `@grn`.
  @caller("platform")
  entity OrgMembers;

  // Containment is the fixed, shallow hierarchy: organization, then
  // team and project, then channel. No team sits in a team.
  //
  // `consents` holds the organizations this one has granted its half of
  // a message toward (ADR-0147 item 2). Tenant isolation lets a send
  // between agents through only where each organization holds the
  // other's, so no organization's entity names another's half. It is
  // optional so an organization stored without one consents to none.
  @grn("org") @caller("platform")
  entity Org { org: Org, members: OrgMembers, consents?: Set<Org> };
  @grn("group") @caller("platform")
  entity Team in [Org] { org: Org };
  @grn("project") @caller("platform")
  entity Project in [Org] { org: Org };
  // `operations` holds the operations its organization's current
  // delegation grants, as action names in their wire form, such as
  // `iam:agent.activate` (ADR-0146, "A hosted operator's delegation").
  // An operator sits in its organization's OrgMembers, as an agent
  // does, which is what tenant isolation reads of a principal. It is
  // optional so an operator stored without one holds none.
  @grn("operator") @caller("platform")
  entity Operator in [OrgMembers, Org] { org: Org, operations?: Set<String> };
  @grn("policy") @caller("none")
  entity Policy in [Org] { org: Org };
  @grn("supervisor") @caller("none")
  entity Supervisor in [Org] { org: Org };
  @grn("service") @caller("none")
  entity Service in [Org] { org: Org };
  @grn("agent") @caller("platform")
  entity Agent in [OrgMembers, Org, Team, Project] { org: Org };
  @grn("user") @caller("platform")
  entity User in [OrgMembers, Team, Project];

  // A role is an action group, granted through a template in
  // system-policies/. These three hold what Role.Actions grants in
  // platform/internal/org/role.go, and a test holds the two together
  // until roles leave the platform (ADR-0130). A service's action joins
  // a role by naming the group as its parent (ADR-0143 item 5).
  action "role-owner", "role-admin", "role-member";

  // Each `<type>.*` group is the wildcard Role.Actions names, spelled
  // `iam:<type>.*`, and holds every action of that type and no other
  // (ADR-0145 item 2). Agent, operator and cowork actions are named one
  // at a time and have none, so a later action is granted when it is
  // decided.
  action "org.*" in ["role-owner"];
  action "group.*", "project.*", "policy.*", "consent.*"
    in ["role-owner", "role-admin"];

  action "org.read", "org.member-list"
    in ["org.*", "role-admin", "role-member"]
    appliesTo { principal: [User, Agent], resource: [Org] };
  action "org.update", "org.invite" in ["org.*", "role-admin"]
    appliesTo { principal: [User, Agent], resource: [Org] };
  action "org.delete" in ["org.*"]
    appliesTo { principal: [User, Agent], resource: [Org] };

  action "group.read", "group.member-list" in ["group.*", "role-member"]
    appliesTo { principal: [User, Agent], resource: [Org, Team] };
  action "group.create", "group.update", "group.delete",
    "group.member-add", "group.member-remove" in ["group.*"]
    appliesTo { principal: [User, Agent], resource: [Org, Team] };

  action "project.read", "project.member-list"
    in ["project.*", "role-member"]
    appliesTo { principal: [User, Agent], resource: [Org, Project] };
  action "project.create", "project.update", "project.delete",
    "project.member-add", "project.member-remove" in ["project.*"]
    appliesTo { principal: [User, Agent], resource: [Org, Project] };

  action "policy.create", "policy.read", "policy.update",
    "policy.attach", "policy.detach", "policy.delete" in ["policy.*"]
    appliesTo { principal: [User, Agent], resource: [Org, Policy] };

  // Writing a `permit` is held by `role-owner` and by no group a lesser
  // role holds: its type is `permit`, so `policy.*` does not name it
  // (ADR-0145 item 4).
  action "permit.write" in ["role-owner"]
    appliesTo { principal: [User, Agent], resource: [Org, Policy] };

  action "consent.read", "consent.grant", "consent.withdraw"
    in ["consent.*"]
    appliesTo { principal: [User, Agent], resource: [Org] };

  // An operator is a principal of the delegable operations, the ten
  // `Operator` appears in below, and of no other action (ADR-0146).
  action "operator.read" in ["role-owner", "role-admin", "role-member"]
    appliesTo { principal: [User, Agent, Operator], resource: [Org, Operator] };
  action "operator.register", "operator.update", "operator.delete",
    "operator.reissue", "operator.delegate"
    in ["role-owner", "role-admin"]
    appliesTo { principal: [User, Agent], resource: [Org, Operator] };

  action "agent.read", "agent.rename"
    in ["role-owner", "role-admin", "role-member"]
    appliesTo { principal: [User, Agent], resource: [Org, Agent] };
  action "agent.create"
    in ["role-owner", "role-admin", "role-member"]
    appliesTo { principal: [User, Agent, Operator], resource: [Org, Agent] };
  action "agent.enroll" in ["role-owner", "role-admin"]
    appliesTo { principal: [User, Agent], resource: [Org, Agent] };
  action "agent.configure", "agent.recover", "agent.replace",
    "agent.execution-read"
    in ["role-owner", "role-admin"]
    appliesTo { principal: [User, Agent, Operator], resource: [Org, Agent] };

  // No role holds it: a grant carries it or nothing does (ADR-0022).
  action "agent.watch"
    appliesTo { principal: [User, Agent], resource: [Org, Agent] };

  // Activating an agent is a delegated operation the platform writes
  // (ADR-0078). No role holds it, as with `agent.watch`.
  action "agent.activate"
    appliesTo { principal: [User, Agent, Operator], resource: [Org, Agent] };

  action "agent-template.read", "execution-profile.read"
    in ["role-owner", "role-admin", "role-member"]
    appliesTo { principal: [User, Agent, Operator], resource: [Org] };
  action "agent-template.publish" in ["role-owner", "role-admin"]
    appliesTo { principal: [User, Agent, Operator], resource: [Org] };

  action "message.send"
    appliesTo { principal: [Agent], resource: [Agent] };
}
