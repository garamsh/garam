# Base URL of the Go backend (`garam serve api`). The `/api/*` rewrite
# and the server-side API client both target it; browsers never see it.
# Optional in development, where it defaults to the value below;
# required in production — a build without it fails fast.
GARAM_API_URL=http://localhost:8080

# Where the console is served (ADR-0131). Signing in lands there, and
# a console path asked of the site is redirected to it. Optional in
# development, where it defaults to the value below.
GARAM_CONSOLE_URL=http://console.garam.localhost:3000
