# Base URL of the Go backend (`garam serve api`). The `/api/*` rewrite
# and the server-side API client both target it; browsers never see it.
GARAM_API_URL=http://localhost:8080

# Postgres the Playwright suite seeds sessions into. Must be the same
# database `garam serve api` is pointed at.
GARAM_E2E_DATABASE_URL=postgres://garam:garam@localhost:55432/garam?sslmode=disable
